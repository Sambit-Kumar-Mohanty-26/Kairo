# ==============================================================================
# Kairo Enterprise VPC / Air-Gapped Deployment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=kairo_admin
POSTGRES_PASSWORD=replace_with_strong_password_for_enterprise_production
POSTGRES_DB=kairo_enterprise

# Authentication & Session Security (SOC 2 Compliant)
JWT_SECRET=generate_with_openssl_rand_hex_32_characters_minimum

# ML Microservice Communication
KAIRO_ML_TOKEN=internal_cluster_bearer_token_between_api_and_ml

# Networking & Ingress
CORS_ORIGINS=http://localhost,https://kairo.internal.yourorg.com
FRONTEND_URL=http://localhost

# Enterprise Notification Dispatcher (Optional)
# Set your Slack / Discord / Splunk SIEM incoming webhook URL:
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SIEM_WEBHOOK_URL=

# Active Response Engine (IPS) Configuration
# Enables automated host isolation / firewall drop for flows with risk >= 88
ENABLE_ACTIVE_IPS=true
IPS_DEFAULT_DURATION_HOURS=24
