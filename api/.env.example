# Neon: use the POOLED connection string (host contains -pooler), not the direct one.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/kairo?sslmode=require

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Comma-separated. Must be the exact frontend origin — no wildcard, no trailing slash.
CORS_ORIGINS=http://localhost:3000,https://kairo.vercel.app

# Where the frontend lives, used to build password-reset links.
FRONTEND_URL=http://localhost:3000

# Google OAuth — console.cloud.google.com > Credentials > OAuth client (Web).
# Authorised redirect URI must be <backend>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Unset = reset links print to the server log (fine for dev).
RESEND_API_KEY=
EMAIL_FROM=Kairo <onboarding@resend.dev>
