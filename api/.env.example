# Neon connection string, exactly as the console gives it to you. Prisma runs
# both queries and migrations over this — the pooler handles the DDL fine.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Comma-separated. Must be the exact frontend origin — no wildcard, no trailing slash.
CORS_ORIGINS=http://localhost:3000,https://kairo.vercel.app

# Where the frontend lives. Password-reset links, the post-OAuth bounce, and
# the Google redirect URI below are all built from this — a wrong value here
# breaks sign-in, not just email. No trailing slash.
FRONTEND_URL=http://localhost:3000

# Google OAuth — console.cloud.google.com > Credentials > OAuth client (Web).
# Authorised redirect URI is on the FRONTEND, not this service:
#   <FRONTEND_URL>/api/auth/google/callback
# The frontend rewrites that path here (frontend/next.config.ts) so the whole
# sign-in flow stays on one origin. Set OAUTH_REDIRECT_URL only to override.
# GOOGLE_CLIENT_ID also has to be set on the frontend, which builds that URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Unset = reset links print to the server log (fine for dev).
RESEND_API_KEY=
EMAIL_FROM=Kairo <onboarding@resend.dev>

# The Python inference service (ml/). Unset = /ml answers 503, which is fine
# until you need Test Mode. Locally run it on 8001: this API defaults to 8000.
#   PYTHONPATH=src uvicorn kairo_ml.service:app --port 8001
ML_URL=http://localhost:8001
