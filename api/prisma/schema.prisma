generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tenancy lives in the schema from migration one. Adding it later means
/// rewriting every query; adding the org-switching UI later costs nothing.
/// Register creates an org and its owner together.
model Organization {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(120)
  slug            String           @unique @db.VarChar(140)
  createdAt       DateTime         @default(now()) @map("created_at")
  users           User[]
  offices         Office[]
  quarantineRules QuarantineRule[]
  webhooks        WebhookEndpoint[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String   @unique @db.VarChar(255)
  fullName       String?  @map("full_name") @db.VarChar(120)
  /// null for Google-only accounts, which have no password to verify
  passwordHash   String?  @map("password_hash") @db.VarChar(255)
  googleSub      String?  @unique @map("google_sub") @db.VarChar(64)
  role           String   @default("owner") @db.VarChar(20)
  emailVerified  Boolean  @default(false) @map("email_verified")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([organizationId])
  @@map("users")
}

/// Stored as a SHA-256 hash, never in the clear: a database leak shouldn't
/// hand over live sessions. Revocable, which is what access tokens are not.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Four levels, always populated: Organization > Office > Network > Sensor.
/// The landing page promises exactly this, and a detection is useless without
/// it — "something attacked 10.20.1.10" against "the router fronting the
/// Bangalore DMZ is under a SYN flood".
model Office {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(120)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  networks     Network[]

  @@unique([organizationId, name])
  @@map("offices")
}

/// A subnet, named. CIDR rather than a VLAN tag: it is what an operator can
/// read off their own router without asking anyone, and it is what lets a
/// flow's addresses be attributed to a network without the agent being told.
model Network {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  name      String   @db.VarChar(120)
  /// 43 chars fits the longest IPv6 CIDR.
  cidr      String   @db.VarChar(43)
  createdAt DateTime @default(now()) @map("created_at")

  office  Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  sensors Sensor[]

  @@unique([officeId, name])
  @@map("networks")
}

/// A capture point. Holds no model and no thresholds — it computes flow
/// statistics and posts them. Its key is stored as a SHA-256 hash for the same
/// reason refresh tokens are: a database leak must not hand over live ingest.
model Sensor {
  id          String    @id @default(uuid()) @db.Uuid
  networkId   String    @map("network_id") @db.Uuid
  name        String    @db.VarChar(120)
  keyHash     String    @unique @map("key_hash") @db.VarChar(64)
  /// Set on every accepted batch and heartbeat. "Live" is derived from this.
  lastSeenAt  DateTime? @map("last_seen_at")
  lastBatchId String?   @map("last_batch_id") @db.VarChar(64)
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  /// Operational health & telemetry fields (Phase 2)
  version         String?   @db.VarChar(32)
  status          String    @default("pending") @db.VarChar(20)
  captureStatus   String?   @map("capture_status") @db.VarChar(30)
  interfaceName   String?   @map("interface_name") @db.VarChar(64)
  packetsObserved BigInt    @default(0) @map("packets_observed")
  flowsExtracted  BigInt    @default(0) @map("flows_extracted")
  pendingBatches  Int       @default(0) @map("pending_batches")
  queueBytes      BigInt    @default(0) @map("queue_bytes")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  lastUploadAt    DateTime? @map("last_upload_at")
  recentWarning   String?   @map("recent_warning") @db.VarChar(255)

  network         Network           @relation(fields: [networkId], references: [id], onDelete: Cascade)
  detections      Detection[]
  rollups         FlowRollup[]
  heartbeats      SensorHeartbeat[]
  batches         IngestedBatch[]
  quarantineRules QuarantineRule[]

  @@unique([networkId, name])
  @@map("sensors")
}

model SensorHeartbeat {
  id              String   @id @default(uuid()) @db.Uuid
  sensorId        String   @map("sensor_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  status          String   @db.VarChar(20)
  captureStatus   String?  @map("capture_status") @db.VarChar(30)
  packetsObserved BigInt   @default(0) @map("packets_observed")
  flowsExtracted  BigInt   @default(0) @map("flows_extracted")
  pendingBatches  Int      @default(0) @map("pending_batches")
  queueBytes      BigInt   @default(0) @map("queue_bytes")
  warning         String?  @db.VarChar(255)

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId, createdAt])
  @@map("sensor_heartbeats")
}

model IngestedBatch {
  id        String   @id @default(uuid()) @db.Uuid
  sensorId  String   @map("sensor_id") @db.Uuid
  batchId   String   @map("batch_id") @db.VarChar(64)
  flowCount Int      @map("flow_count")
  createdAt DateTime @default(now()) @map("created_at")

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@unique([sensorId, batchId])
  @@index([sensorId, createdAt])
  @@map("ingested_batches")
}

/// One row per attack verdict. Benign flows never become rows — they become
/// counters in FlowRollup, which is the difference between a table that grows
/// with attacks and one that grows with traffic.
model Detection {
  id             String @id @default(uuid()) @db.Uuid
  sensorId       String @map("sensor_id") @db.Uuid
  /// Denormalised from sensor > network > office: every console query is
  /// org-scoped and time-ordered, and three joins to get there is the query
  /// that gets slow first.
  organizationId String @map("organization_id") @db.Uuid

  /// The agent's own id for the flow. Unique per sensor, so a retried batch
  /// after a timeout is idempotent instead of duplicated.
  flowId     String @map("flow_id") @db.VarChar(64)
  attack     String @db.VarChar(20)
  confidence Float
  risk       Int    @db.SmallInt
  severity   String @db.VarChar(10)
  /// What the model weighed, as returned by /predict. Stored because an
  /// explanation that cannot be shown later is not an explanation.
  features   Json
  modelTag   String @map("model_tag") @db.VarChar(40)

  sourceIp   String   @map("source_ip") @db.VarChar(45)
  sourcePort Int      @map("source_port")
  targetIp   String   @map("target_ip") @db.VarChar(45)
  targetPort Int      @map("target_port")
  protocol   String   @db.VarChar(8)
  startedAt  DateTime @map("started_at")

  /// new | acknowledged | investigating | resolved | false-positive. Every
  /// change is an audit row: a resolved or false-positive verdict is a
  /// labelled flow, so who labelled it is part of the training data.
  status    String           @default("new") @db.VarChar(16)
  createdAt DateTime         @default(now()) @map("created_at")
  sensor    Sensor           @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  events    DetectionEvent[]

  @@unique([sensorId, flowId])
  @@index([organizationId, createdAt])
  @@index([organizationId, startedAt])
  @@index([organizationId, status])
  @@map("detections")
}

/// Who changed a verdict and when. The Model tab counts resolved and
/// false-positive rows as training labels, so the provenance of a label is
/// part of the training data, not UI history.
model DetectionEvent {
  id          String   @id @default(uuid()) @db.Uuid
  detectionId String   @map("detection_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  status      String   @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")

  detection Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  @@index([detectionId])
  @@map("detection_events")
}

/// Benign traffic as counters, one row per sensor per minute. This is what
/// makes "flows analysed" a real number without storing a row per flow.
model FlowRollup {
  id       String   @id @default(uuid()) @db.Uuid
  sensorId String   @map("sensor_id") @db.Uuid
  minute   DateTime @db.Timestamptz(3)
  flows    Int      @default(0)
  attacks  Int      @default(0)
  bytes    BigInt   @default(0)

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@unique([sensorId, minute])
  @@map("flow_rollups")
}

/// Active IPS Quarantine: Dropped at host firewall (Linux iptables/nftables & Windows Netsh)
/// and blocked at Layer 4 across all distributed sensors.
model QuarantineRule {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sourceIp       String    @map("source_ip") @db.VarChar(45)
  reason         String    @db.VarChar(120)
  attack         String?   @db.VarChar(30)
  risk           Int       @default(0) @db.SmallInt
  severity       String?   @db.VarChar(10)
  flowId         String?   @map("flow_id") @db.VarChar(64)
  sensorId       String?   @map("sensor_id") @db.Uuid
  status         String    @default("active") @db.VarChar(20) // active | released | expired
  expiresAt      DateTime? @map("expires_at")
  unblockedAt    DateTime? @map("unblocked_at")
  unblockedBy    String?   @map("unblocked_by") @db.VarChar(120)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sensor       Sensor?      @relation(fields: [sensorId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([sourceIp])
  @@map("quarantine_rules")
}

/// Webhook alert endpoints (Discord, Slack, Datadog/Splunk SIEM).
model WebhookEndpoint {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(120)
  url            String    @db.VarChar(512)
  format         String    @default("discord") @db.VarChar(20) // discord | slack | generic
  secret         String?   @db.VarChar(128)
  minRisk        Int       @default(70) @map("min_risk") @db.SmallInt
  enabled        Boolean   @default(true)
  lastSuccessAt  DateTime? @map("last_success_at")
  lastFailureAt  DateTime? @map("last_failure_at")
  failureCount   Int       @default(0) @map("failure_count")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled])
  @@map("webhook_endpoints")
}
