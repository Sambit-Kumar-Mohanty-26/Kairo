# Backend origin. Local: http://localhost:8000 — production: your Render URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth client ID — the same value as the API's GOOGLE_CLIENT_ID. The
# client *secret* stays on the API; a client ID is public by design (it ships in
# the redirect to Google either way). Needed here because this app builds the
# authorisation URL itself, so the browser never detours through the backend.
GOOGLE_CLIENT_ID=
